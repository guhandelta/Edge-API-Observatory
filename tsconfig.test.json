{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["@cloudflare/vitest-plugin/types", "vitest/globals"]
  },
  "include": ["test/setup.ts", "test/worker.spec.ts", "test/metrics.spec.ts", "shared", "worker", "worker-configuration.d.ts"]
}
